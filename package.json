{
  "name": "broken-link-checker-html",
  "version": "1.0.0",
  "description": "Fast broken link detection for HTML content. Detects broken URLs, images, and invalid href values.",
  "keywords": [
    "broken-links",
    "link-checker",
    "dead-links",
    "html",
    "seo",
    "web",
    "url-checker",
    "404",
    "invalid-href",
    "typescript"
  ],
  "author": "Hayati Ali Keles <hayatialikeles@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hayatialikeles/broken-link-checker-html.git"
  },
  "bugs": {
    "url": "https://github.com/hayatialikeles/broken-link-checker-html/issues"
  },
  "homepage": "https://github.com/hayatialikeles/broken-link-checker-html#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "broken-link-checker": "./dist/cli.js",
    "blc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/index.test.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0"
  },
  "dependencies": {}
}
